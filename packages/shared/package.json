    "lint": "echo \"No lint configured for shared\"",
    "test": "node --import tsx --test src/**/*.spec.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
