# Application
NODE_ENV=development
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# PostgreSQL
DATABASE_URL=postgresql://qa:qa@localhost:5432/qa_workbench?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Encryption key for secrets at rest (32+ chars). Change in real deployments.
SECRETS_ENCRYPTION_KEY=change-me-to-a-long-random-secret-key

# Jira (Phase 2) — leave empty for Phase 1
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Ollama (Phase 2) — leave empty for Phase 1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# HTTP Scenario Runner — set true to block private/loopback hosts (SSRF harden)
HTTP_BLOCK_PRIVATE=false
